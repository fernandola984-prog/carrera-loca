// Aplica a public/index.html: público, árboles, pancartas FerLudu y líneas de velocidad.
// Uso (en la carpeta del proyecto):  node aplicar-mejoras.js
const fs = require('fs'), f = 'public/index.html';
let s = fs.readFileSync(f, 'utf8');
if (s.includes('/*FL-ESCENARIO*/')) { console.log('Ya aplicado.'); process.exit(0); }
fs.writeFileSync(f + '.bak', s);
const rep = (a, b) => { if (s.split(a).length !== 2) { console.error('No encuentro (o está repetido) el anclaje:\n' + a); process.exit(1); } s = s.replace(a, () => b); };

const SCENERY = String.raw`/*FL-ESCENARIO*/
 const rn=a=>{const q=Math.sin(a*127.1+311.7)*43758.5453;return q-Math.floor(q)};
 const tree=(x,y,k)=>{const[sx,sy,s]=P(x,y),u=s*XS,h=(80+rn(k)*50)*u;c.fillStyle='#0003';c.beginPath();c.ellipse(sx,sy,28*u,8*u,0,0,7);c.fill();c.fillStyle='#6d4c41';c.fillRect(sx-5*u,sy-h*.45,10*u,h*.45);[['#2e7d32',0,.62,30],['#388e3c',-16,.5,22],['#43a047',16,.5,22],['#66bb6a',0,.82,20]].forEach(q=>{c.fillStyle=q[0];c.beginPath();c.arc(sx+q[1]*u,sy-h*q[2],q[3]*u,0,7);c.fill()})};
 const stand=(x,y,k)=>{const[sx,sy,s]=P(x,y),u=s*XS,w=150*u,h=76*u;c.fillStyle='#455a64';c.fillRect(sx-w/2,sy-h,w,h);c.fillStyle='#c62828';c.fillRect(sx-w/2-3*u,sy-h-8*u,w+6*u,9*u);
  for(let r=0;r<3;r++)for(let q=0;q<7;q++){const hx=sx-w/2+(q+.5)*w/7,b=Math.abs(Math.sin(tm*6+q*1.7+r*2+k))*9*u,hy=sy-h*(.2+.27*r)-b;c.fillStyle='hsl('+(rn(k*31+q*7+r*3)*360|0)+',75%,45%)';c.fillRect(hx-6*u,hy,12*u,14*u);c.fillStyle='#f5c28b';c.beginPath();c.arc(hx,hy-5*u,6*u,0,7);c.fill();if(rn(k+q*5+r)>.7){c.strokeStyle='#fff';c.lineWidth=2*u;c.beginPath();c.moveTo(hx+6*u,hy+2*u);c.lineTo(hx+11*u,hy-14*u-b);c.stroke()}}};
 const sign=(x,y)=>{const[sx,sy,s]=P(x,y),u=s*XS,w=110*u,h=36*u;c.fillStyle='#777';c.fillRect(sx-w/2+8*u,sy-50*u,5*u,50*u);c.fillRect(sx+w/2-13*u,sy-50*u,5*u,50*u);c.fillStyle='#ffeb3b';c.fillRect(sx-w/2,sy-50*u-h,w,h);c.strokeStyle='#d50000';c.lineWidth=4*u;c.strokeRect(sx-w/2,sy-50*u-h,w,h);c.fillStyle='#d50000';c.font=(h*.7)+'px Impact';c.textAlign='center';c.fillText('FerLudu',sx,sy-50*u-h*.22)};
 const gantry=y=>{const[ax,sy,s]=P(-25,y),bx=P(625,y)[0],u=s*XS,ph=130*u;c.fillStyle='#546e7a';c.fillRect(ax-6*u,sy-ph,12*u,ph);c.fillRect(bx-6*u,sy-ph,12*u,ph);c.fillStyle='#d50000';c.fillRect(ax,sy-ph,bx-ax,40*u);c.fillStyle='#ffeb3b';c.fillRect(ax,sy-ph,bx-ax,4*u);c.fillRect(ax,sy-ph+36*u,bx-ax,4*u);c.fillStyle='#fff';c.font=(30*u)+'px Impact';c.textAlign='center';c.fillText('★ FerLudu · GRAN CARRERA LOCA ★',(ax+bx)/2,sy-ph+30*u)};
 for(let k=Math.floor((camY-60)/60);k<(camY+1700)/60;k++){const y=k*60;if(y<-60||y>TRACK+240)continue;
  for(const sd of[-1,1]){if(rn(Math.floor(k/5)*3+(sd+1)*9)>.5)E.push({y,f:()=>stand(sd<0?-95:695,y,k)});else{const j=rn(k*2+sd)*150;E.push({y,f:()=>tree(sd<0?-70-j:670+j,y,k)})}
   if(k%8===0)E.push({y,f:()=>sign(sd<0?-60:660,y)})}
  if(k%16===8)E.push({y,f:()=>gantry(y)})}
`;
const SPEED = String.raw`
 {const sp=me.sp||0,it=Math.min(1,Math.max(me.b?.9:0,(sp-80)/160));
  if(it>.02){c.save();c.strokeStyle='#fff';c.lineCap='round';const vx=W/2,vy=hy+(py-hy)*.1,R=Math.hypot(W,H);
   for(let i=0;i<30;i++){const a=rn(i*3.1)*Math.PI*2,u=((tm*(1.6+rn(i)*1.4)+rn(i*7))%1),r0=R*(.12+.5*u*u),r1=r0+R*.12*it+20;
    c.globalAlpha=it*.45*(.4+u*.6);c.lineWidth=1.5+3*u;c.beginPath();c.moveTo(vx+Math.cos(a)*r0,vy+Math.sin(a)*r0*.8);c.lineTo(vx+Math.cos(a)*r1,vy+Math.sin(a)*r1*.8);c.stroke()}
   c.restore()}}`;
rep("const E=[];c.textAlign='center';", "const E=[];c.textAlign='center';\n" + SCENERY);
rep("E.sort((a,b)=>b.y-a.y).forEach(e=>e.f());", "E.sort((a,b)=>b.y-a.y).forEach(e=>e.f());" + SPEED);
rep("(function loop(){const tm=(performance.now()-T0)/1000;", "let lt=0;(function loop(){const tm=(performance.now()-T0)/1000,dt=Math.max(.001,tm-lt);lt=tm;");
rep("d.wp=(d.wp||0)+(d.y-oy)*1.2}", "d.wp=(d.wp||0)+(d.y-oy)*1.2;d.sp=(d.sp||0)*.9+(d.y-oy)/dt*.1}");
fs.writeFileSync(f, s);
console.log('Mejoras aplicadas (copia de seguridad: ' + f + '.bak)');
